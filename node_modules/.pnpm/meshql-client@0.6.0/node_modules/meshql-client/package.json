{
  "name": "meshql-client",
  "version": "0.6.0",
  "description": "MeshQL typed client SDK",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "meshql-core": "^0.7.1"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshql/meshql.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/meshql/meshql#readme",
  "bugs": {
    "url": "https://github.com/meshql/meshql/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
