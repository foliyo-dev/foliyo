{
  "name": "meshql-integrity",
  "version": "0.5.5",
  "description": "MeshQL full token lifecycle integrity verification",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "meshql-core": "^0.7.1",
    "meshql-http": "^0.6.0"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meshql/meshql.git",
    "directory": "packages/integrity"
  },
  "homepage": "https://github.com/meshql/meshql#readme",
  "bugs": {
    "url": "https://github.com/meshql/meshql/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
