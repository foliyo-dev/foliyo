{
	"name": "@foliyo/dashboard",
	"private": true,
	"version": "0.4.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:saas": "VITE_SAAS=true VITE_API_URL=http://localhost:8080/api VITE_SITE_URL=http://localhost:8080 VITE_LANDING_URL=http://localhost:5175 vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"predev": "bash ../../scripts/sync-brand-assets.sh",
		"prebuild": "bash ../../scripts/sync-brand-assets.sh",
		"sync-brand": "bash ../../scripts/sync-brand-assets.sh",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"clean": "rm -rf build .svelte-kit"
	},
	"dependencies": {
		"@foliyo/brand": "workspace:*",
		"@foliyo/ui": "workspace:*",
		"meshql-client": "^0.6.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.9.1",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	}
}
