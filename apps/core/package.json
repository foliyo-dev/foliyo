{
  "name": "@foliyo/core",
  "version": "0.6.7",
  "private": true,
  "type": "module",
  "description": "Foliyo API + public pages (Hono + MeshQL). Released as foliyo-core-*.tgz on GitHub Releases; npm later.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "clean": "rm -rf dist",
    "seed:ats": "tsx src/seed-ats-partner.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.2",
    "hono": "^4.4.0",
    "meshql-access": "^0.2.6",
    "meshql-core": "^0.7.1",
    "meshql-http": "^0.6.1",
    "meshql-integrity": "^0.5.5",
    "meshql-postgres": "0.5.4",
    "meshql-sqlite": "^0.5.4",
    "meshql-upload": "^0.5.4",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.14",
    "pg": "^8.22.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8",
    "@types/pg": "^8.20.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "src",
    "public",
    "package.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./assets": "./src/assets.ts",
    "./create-app": "./src/create-app.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./migrate": "./src/migrate.ts",
    "./plan": "./src/plan.ts",
    "./auth/password": "./src/auth/password.ts",
    "./auth/tokens": "./src/auth/tokens.ts",
    "./email/send": "./src/email/send.ts",
    "./email/verify": "./src/email/verify.ts",
    "./email/password-reset": "./src/email/password-reset.ts",
    "./email/layout": "./src/email/layout.ts",
    "./public/pages": "./src/public/pages.ts",
    "./public/themes": "./src/public/themes.ts",
    "./social/providers": "./src/social/providers.ts",
    "./spec/resume": "./src/spec/resume.ts",
    "./spec/fio": "./src/spec/fio.ts"
  }
}
