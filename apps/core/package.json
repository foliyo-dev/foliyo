{
  "name": "@foliyo/core",
  "version": "0.6.21",
  "private": true,
  "type": "module",
  "description": "Foliyo API + public pages (Hono + MeshQL). Released as foliyo-core-*.tgz on GitHub Releases; npm later.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --noEmit",
    "migrate": "tsx src/migrate-cli.ts",
    "seed:demo": "tsx src/seed-demo.ts",
    "test": "tsx --test src/jobs/*.test.ts src/skills/*.test.ts src/import/*.test.ts src/auth/*.test.ts src/http-url.test.ts src/config.test.ts src/content-order.test.ts",
    "clean": "rm -rf dist",
    "seed:ats": "tsx src/seed-ats-partner.ts"
  },
  "dependencies": {
    "@foliyo/jobs-client": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "bcryptjs": "^2.4.3",
    "fflate": "^0.8.2",
    "hono": "^4.4.0",
    "@meshqljs/access": "^0.2.14",
    "@meshqljs/core": "^0.11.2",
    "@meshqljs/http": "^0.8.5",
    "@meshqljs/integrity": "^0.5.14",
    "@meshqljs/postgres": "^0.6.6",
    "@meshqljs/sqlite": "^0.6.6",
    "@meshqljs/upload": "^0.5.12",
    "nanoid": "^5.0.7",
    "nodemailer": "^6.9.14",
    "pg": "^8.22.0",
    "yaml": "^2.4.5",
    "zod": "^3.23.8",
    "@types/pg": "^8.20.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "files": [
    "src",
    "public",
    "package.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./assets": "./src/assets.ts",
    "./create-app": "./src/create-app.ts",
    "./config": "./src/config.ts",
    "./db": "./src/db.ts",
    "./migrate": "./src/migrate.ts",
    "./plan": "./src/plan.ts",
    "./auth/password": "./src/auth/password.ts",
    "./auth/tokens": "./src/auth/tokens.ts",
    "./auth/datetime": "./src/auth/datetime.ts",
    "./auth/secret": "./src/auth/secret.ts",
    "./auth/rate-limit": "./src/auth/rate-limit.ts",
    "./auth/limit": "./src/auth/limit.ts",
    "./auth/pending-signup": "./src/auth/pending-signup.ts",
    "./auth/oauth": "./src/auth/oauth.ts",
    "./email/send": "./src/email/send.ts",
    "./email/verify": "./src/email/verify.ts",
    "./email/password-reset": "./src/email/password-reset.ts",
    "./email/layout": "./src/email/layout.ts",
    "./public/pages": "./src/public/pages.ts",
    "./public/themes": "./src/public/themes.ts",
    "./social/providers": "./src/social/providers.ts",
    "./spec/resume": "./src/spec/resume.ts",
    "./spec/fio": "./src/spec/fio.ts",
    "./jobs": "./src/jobs/index.ts",
    "./account/clear-content": "./src/account/clear-content.ts",
    "./skills/ontology": "./src/skills/ontology.ts",
    "./skills/seed-ontology": "./src/skills/seed-ontology.ts"
  }
}
