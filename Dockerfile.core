# Foliyo OSS API (Hono) — multi-stage production image
# Build: docker build -f Dockerfile.core -t foliyo-core .
FROM node:22-bookworm-slim AS builder
WORKDIR /app

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY apps/core/package.json apps/core/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/extension/package.json apps/extension/
COPY packages/brand/package.json packages/brand/
COPY packages/ui/package.json packages/ui/
COPY packages/themes/package.json packages/themes/
COPY packages/jobs-client/package.json packages/jobs-client/

RUN pnpm install --frozen-lockfile

COPY . .
ENV SKIP_PNPM_INSTALL=1
RUN bash scripts/build-core-bundle.sh

FROM node:22-bookworm-slim AS runtime
WORKDIR /app

RUN useradd --system --uid 10001 --create-home foliyo
COPY --from=builder --chown=foliyo:foliyo /app/dist/core/ ./

ENV NODE_ENV=production \
    FOLIYO_HOST=0.0.0.0 \
    FOLIYO_PORT=8080 \
    FOLIYO_ASSETS_DIR=/app/assets \
    FOLIYO_DATA_DIR=/data \
    FOLIYO_DB_DRIVER=sqlite \
    FOLIYO_DB_PATH=/data/foliyo.db

RUN mkdir -p /data && chown foliyo:foliyo /data
USER foliyo
EXPOSE 8080
VOLUME ["/data"]
CMD ["node", "server.mjs"]
