# Foliyo dashboard (static SvelteKit) — nginx runtime
# OSS:  docker build -f Dockerfile.dashboard -t foliyo-dashboard .
# SaaS: docker build -f Dockerfile.dashboard --build-arg VITE_SAAS=true -t foliyo-saas-dashboard .
FROM node:22-bookworm-slim AS builder
WORKDIR /app

ARG VITE_SAAS=false
ARG VITE_API_URL=/api
ARG VITE_SITE_URL=http://localhost:8080
ARG VITE_LANDING_URL=http://localhost:5175
ARG VITE_APP_URL=http://localhost:3000

ENV VITE_SAAS=$VITE_SAAS \
    VITE_API_URL=$VITE_API_URL \
    VITE_SITE_URL=$VITE_SITE_URL \
    VITE_LANDING_URL=$VITE_LANDING_URL \
    VITE_APP_URL=$VITE_APP_URL

RUN corepack enable && corepack prepare pnpm@11.18.0 --activate

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY apps/core/package.json apps/core/
COPY apps/dashboard/package.json apps/dashboard/
COPY apps/extension/package.json apps/extension/
COPY packages/brand/package.json packages/brand/
COPY packages/ui/package.json packages/ui/
COPY packages/themes/package.json packages/themes/
COPY packages/jobs-client/package.json packages/jobs-client/

RUN pnpm install --frozen-lockfile

COPY . .
RUN bash scripts/sync-brand-assets.sh \
 && pnpm --filter @foliyo/dashboard build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /app/apps/dashboard/build /usr/share/nginx/html
COPY infra/nginx-dashboard.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
