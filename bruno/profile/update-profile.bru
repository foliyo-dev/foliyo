meta {
  name: Update Profile
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Jane Developer",
    "headline": "Full Stack Engineer",
    "bio": "Building things with Go and Svelte.",
    "avatar_url": "",
    "location": "India",
    "email": "jane@example.com",
    "website": "https://example.com",
    "github": "janedev",
    "linkedin": "janedev",
    "twitter": "janedev"
  }
}
