meta {
  name: Me
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/auth/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("should return current user", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().user).to.be.an("object");
  });
}
