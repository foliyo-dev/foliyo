meta {
  name: Update Project
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/projects/{{projectId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "title": "Foliyo",
    "description": "Updated description",
