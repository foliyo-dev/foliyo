meta {
  name: Update Settings
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/settings
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "site_title": "My Portfolio",
    "site_description": "Developer portfolio",
    "theme_slug": "minimal",
    "resume_theme": "classic",
    "custom_domain": "",
    "seo_keywords": "portfolio,developer"
  }
}
