meta {
  name: Create Skill
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/skills
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Go",
    "level": "advanced",
    "category": "backend",
    "sort_order": 0
  }
}

script:post-response {
  if (res.getStatus() === 201 || res.getStatus() === 200) {
    const items = res.getBody();
    if (Array.isArray(items) && items.length > 0) {
      bru.setEnvVar("skillId", items[items.length - 1].id);
    }
  }
}
