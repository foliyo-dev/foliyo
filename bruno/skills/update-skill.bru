meta {
  name: Update Skill
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/skills/{{skillId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Go",
    "level": "expert",
    "category": "backend",
    "sort_order": 0
  }
}
