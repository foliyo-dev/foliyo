{
  "name": "@foliyo/themes",
  "version": "0.5.1",
  "private": true,
  "description": "Portfolio and resume theme CSS + metadata for Foliyo public pages",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./portfolio/*/style.css": "./portfolio/*/style.css",
