# Foliyo OSS / self-host — copy to .env for local overrides
#   cp .env.example .env
#
# Same role as foliyo-cloud/.env for the open-source engine.

FOLIYO_PORT=8080
FOLIYO_HOST=0.0.0.0
FOLIYO_SITE_URL=http://localhost:8080
FOLIYO_DASHBOARD_URL=http://localhost:5173
FOLIYO_MODE=single

# Optional Google / GitHub login (leave empty = email/password only)
# FOLIYO_OAUTH_ENABLED=true
# OAUTH_REDIRECT_BASE=http://localhost:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional AI (BYOK) — same features as hosted Pro when set; you pay OpenRouter
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash
# AI_REWRITE_MAX_TOKENS=400

# File storage — public URLs stay /uploads/{key}; only the backend changes
# FOLIYO_STORAGE=local
# S3-compatible (AWS S3, Cloudflare R2, MinIO). Required when FOLIYO_STORAGE=s3
# FOLIYO_STORAGE=s3
# FOLIYO_S3_BUCKET=
# FOLIYO_S3_REGION=auto
# FOLIYO_S3_ENDPOINT=           # R2/MinIO endpoint; leave empty for AWS
# FOLIYO_S3_ACCESS_KEY_ID=
# FOLIYO_S3_SECRET_ACCESS_KEY=
# FOLIYO_S3_PREFIX=uploads/
# FOLIYO_S3_FORCE_PATH_STYLE=  # default true when ENDPOINT is set (MinIO)
# Cutover: pnpm --filter @foliyo/core storage:sync [--dry-run] then set FOLIYO_STORAGE=s3
